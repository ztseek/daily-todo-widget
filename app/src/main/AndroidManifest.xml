<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 精确闹钟：Android 12+ 属于"特殊权限"，用户需在系统设置里手动允许。
         AlarmScheduler 里做了降级，没授权也能用，只是误差可能到十几分钟。 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 关机重启后要重新把闹钟排上，否则重启后小部件再也不刷新了 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".TodoApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyTodo">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DailyTodo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 桌面小部件本体。exported=true 是系统（桌面进程）来调用的必要条件 -->
        <receiver
            android:name=".widget.TaskWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <!-- 闹钟到点后由系统唤起，做一次"补算 + 重绘" -->
        <receiver
            android:name=".schedule.RefreshReceiver"
            android:exported="false" />

        <!-- 5 秒撤销窗口到期，清掉撤销条 -->
        <receiver
            android:name=".widget.UndoExpiryReceiver"
            android:exported="false" />

        <!-- 开机 / 应用更新后重建闹钟链 -->
        <receiver
            android:name=".schedule.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
